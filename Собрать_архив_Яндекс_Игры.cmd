@echo off
chcp 65001 >nul
title Сборка чистого архива для Яндекс Игр
powershell -NoProfile -ExecutionPolicy Bypass -Command "$root = '%~dp0'.TrimEnd('\'); $zip = Join-Path $root 'GrimborneHunters_YandexGames.zip'; $stage = Join-Path $env:TEMP 'grimborne_yg_stage'; if (Test-Path $stage) { Remove-Item $stage -Recurse -Force }; New-Item -ItemType Directory -Path $stage | Out-Null; Copy-Item (Join-Path $root 'index.html'), (Join-Path $root 'manifest.json') -Destination $stage; foreach ($d in @('css','js','vendor')) { Copy-Item (Join-Path $root $d) -Destination (Join-Path $stage $d) -Recurse }; $assetsDest = Join-Path $stage 'assets'; New-Item -ItemType Directory -Path $assetsDest | Out-Null; Copy-Item (Join-Path $root 'assets\*') -Destination $assetsDest -Recurse -Force; Get-ChildItem $stage -Recurse -File -Include '*.blend','*.blend1','*.bak*' | Remove-Item -Force; foreach ($drop in @('strelok_preview','cover.png','arena_map.jpg','ui\world_map_regions_clean.png','ui\world_map_regions_clean.jpg','ui\forest_stages_bg_clean.png','ui\forest_stages_bg_clean.jpg','ui\dock_tab_active.png','ui\dock_tab_idle.png','env\floor_tile_large.gltf.glb','env\floor_tile_large_rocks.gltf.glb','env\grave_A.gltf','env\grave_A.bin','env\path_A.gltf','env\path_A.bin','env\misty_graveyard\dl_preview','env\misty_graveyard\uploaded','models\Warrior_Run_inplace.glb','models\Warrior_Tripo.glb','models\9864cc7e-23c8-4f19-b851-b58f2539c26d.glb','models\Mage.glb','models\Rogue_Hooded.glb','models\Skeleton_Rogue.glb')) { $p = Join-Path $assetsDest $drop; if (Test-Path $p) { Remove-Item $p -Recurse -Force } }; if (Test-Path $zip) { Remove-Item $zip -Force }; Compress-Archive -Path (Join-Path $stage '*') -DestinationPath $zip -Force; Remove-Item $stage -Recurse -Force; $mb = [math]::Round((Get-Item $zip).Length / 1MB, 2); Write-Host ('Готово! Чистый архив для Яндекс Игр создан (' + $mb + ' МБ): ' + $zip) -ForegroundColor Green"
pause